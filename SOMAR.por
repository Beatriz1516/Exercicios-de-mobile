programa {
  funcao inicio() {
    inteiro num1, num2, resultado 

    escreva("Digite o primeiro valor: ")
    leia(num1)
    escreva("Digite o segundo valor: ")
    leia(num2)

    resultado = somar(num1, num2)
    escreva("O resultado da soma é ", resultado)
  }
  funcao inteiro somar(inteiro a, inteiro b){
    retorne a + b
  }
}
